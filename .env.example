# ──────────────────────────────────────────────────────────────────────────────
# project0 — environment variables
#
# Copy this file to `.env.local` (Next.js loads it automatically) and fill in
# real values. NEVER commit `.env` / `.env.local` — only this example is tracked.
#
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (server) ─────────────────────────────────────────────────────────
# Postgres connection string used by Prisma (via the pg adapter) and the seed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── Admin API (server) ────────────────────────────────────────────────────────
# Bearer token guarding POST /api/v1/postProjects. Use a long random string.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="change-me-to-a-long-random-token"

# ── Contact email via Resend (server) ─────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Sender address — must be a verified domain/sender in Resend.
RESEND_FROM_EMAIL="noreply@yourdomain.com"
# Your inbox — where contact-form notifications are delivered.
CONTACT_EMAIL="you@yourdomain.com"

# ── Rate-limit / privacy (server) ─────────────────────────────────────────────
# HMAC key used to hash sender IPs before storage (>= 16 chars).
# REQUIRED in production — the contact route throws on boot without it.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT="change-me-to-a-long-random-secret-min-16-chars"

# ── Public links (exposed to the browser) ─────────────────────────────────────
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/your-handle"
NEXT_PUBLIC_GITHUB_URL="https://github.com/your-handle"
NEXT_PUBLIC_CONTACT_EMAIL="you@yourdomain.com"
# URL to your resume/dossier PDF (e.g. /resume.pdf in /public, or a blob URL).
NEXT_PUBLIC_DOSSIER_URL="/resume.pdf"
