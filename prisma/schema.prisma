// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model Project {
  // ── Identity ──────────────────────────────────────────────────────────────
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  category      String
  date          DateTime

  // ── Content ───────────────────────────────────────────────────────────────
  shortDesc     String
  fullDesc      String
  tags          String[]

  // ── Links (null = private / not deployed) ─────────────────────────────────
  githubURL     String?
  deployedURL   String?

  // ── Display control ───────────────────────────────────────────────────────
  active        Boolean   @default(false)
  order         Int       // controls which orbit slot this planet occupies

  // ── Timestamps ────────────────────────────────────────────────────────────
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── 1-to-1 relations ──────────────────────────────────────────────────────
  // The foreign key lives on OrbitConfig/PlanetVisual (child side), so:
  //   • These fields must be optional (?) on the Project side — Prisma rule.
  //   • Cascade delete is defined on the child side → deleting a Project
  //     automatically deletes its OrbitConfig and PlanetVisual rows.
  //   • In TypeScript, use Prisma.ProjectGetPayload<{ include: { orbit: true,
  //     visual: true } }> so orbit/visual are typed as non-nullable.
  orbit         OrbitConfig?
  visual        PlanetVisual?
}

model OrbitConfig {
  id            Int     @id @default(autoincrement())
  radius        Float
  speed         Float
  inclination   Float

  // FK on this side — enables onDelete: Cascade in the correct direction:
  // deleting the parent Project automatically deletes this row.
  projectId     String  @unique
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PlanetVisual {
  id            Int     @id @default(autoincrement())
  textureUrl    String
  sz            Float
  rotationSpeed Float
  glowIntensity Float

  // FK on this side — same cascade delete pattern as OrbitConfig.
  projectId     String  @unique
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  email         String
  message       String

  createdAt     DateTime @default(now())
}
