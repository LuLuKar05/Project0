// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model Project {
  // ── Identity ──────────────────────────────────────────────────────────────
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  category      String
  date          DateTime

  // ── Content ───────────────────────────────────────────────────────────────
  shortDesc     String
  fullDesc      String
  tags          Tag[] 

  // ── Links (null = private / not deployed) ─────────────────────────────────
  githubURL     String?
  deployedURL   String?

  // ── Display control ───────────────────────────────────────────────────────
  active        Boolean   @default(false)
  order         Int       // controls which orbit slot this planet occupies

  // ── Timestamps ────────────────────────────────────────────────────────────
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── 1-to-1 relations ──────────────────────────────────────────────────────
  // The foreign key lives on OrbitConfig/PlanetVisual (child side), so:
  //   • These fields must be optional (?) on the Project side — Prisma rule.
  //   • Cascade delete is defined on the child side → deleting a Project
  //     automatically deletes its OrbitConfig and PlanetVisual rows.
  //   • In TypeScript, use Prisma.ProjectGetPayload<{ include: { orbit: true,
  //     visual: true } }> so orbit/visual are typed as non-nullable.
  orbit         OrbitConfig?
  visual        PlanetVisual?
}

model OrbitConfig {
  id            Int     @id @default(autoincrement())
  radius        Float
  speed         Float
  inclination   Float

  // FK on this side — enables onDelete: Cascade in the correct direction:
  // deleting the parent Project automatically deletes this row.
  projectId     String  @unique
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PlanetVisual {
  id            Int     @id @default(autoincrement())
  textureUrl    String
  sz            Float
  rotationSpeed Float
  glowIntensity Float

  // FK on this side — same cascade delete pattern as OrbitConfig.
  projectId     String  @unique
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id            String   @id @default(uuid())
  requestId     String?  @unique  //idempotency key from the client to prevent duplicate messages
  ipHash        String?           //hash of the sender's IP address for rate limiting
  name          String
  org           String
  type          String
  email         String
  message       String
  emailSent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  @@index([createdAt, ipHash])  //index for rate limiting and querying messages by date
}

model Tag{
  id            Int @id @default(autoincrement())
  name          String @unique
  category      String //@index has to put the index for this field(not sure where in the application code or db) to query tags by category
  color         String  //This is the color code for the tag, e.g. "#FF5733"

  projects       Project[] 
  //fast indexing based on the category field, since we'll often query tags by category to display them in the UI.
  @@index([category])

  //projectTags   ProjectTag[] //one-to-many relationship with ProjectTag model
}

model SkillCategory{
  id            String @id @default(uuid())
  name          String @unique   //Like the System name.
  skills        Skill[]          //one-to-many relationship with Skill model
  displayOrder  Int @default(0)
  //Timestamps 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Skill{
  id            String @id @default(uuid())
  name          String
  categoryId    String
  category      SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  //Timestamps 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([categoryId])
}